{%- liquid
  # Coming-soon lock: shown until the launch time in Theme settings > Coming soon. Skipped in the theme editor.
  assign coming_soon = false
  if settings.coming_soon_enabled and settings.coming_soon_launch != blank and request.design_mode != true
    assign launch_ts = settings.coming_soon_launch | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    if launch_ts > now_ts
      assign coming_soon = true
    endif
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if coming_soon %} class="is-coming-soon"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google-site-verification" content="QRrsQ9gNT8f4tbhR9XI0yyxNIwnc2OlmbNxRVgCdNHI">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if request.page_type == 'cart' or request.page_type == 'search' or request.page_type contains 'customers/' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'structured-data' %}

    {% render 'font-face' %}

    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-accent: {{ settings.color_accent }};
        --product-ratio: {{ settings.product_image_ratio | default: '1 / 1' }};
        --product-fit: {{ settings.product_image_fit | default: 'contain' }};
        --collection-ratio: {{ settings.collection_image_ratio | default: '3 / 4' }};
        --collection-fit: {{ settings.collection_image_fit | default: 'contain' }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        shopPath: {{ settings.shop_path | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          allProducts: {{ routes.all_products_collection_url | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix != blank %}--{{ template.suffix }}{% endif %}">
    {%- if coming_soon -%}{% render 'coming-soon', launch: settings.coming_soon_launch %}{%- endif -%}
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}

    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
