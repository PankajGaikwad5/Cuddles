{%- liquid
  # Coming-soon lock: shown until the launch time in Theme settings > Coming soon. Skipped in the theme editor.
  assign coming_soon = false
  if settings.coming_soon_enabled and settings.coming_soon_launch != blank and request.design_mode != true
    assign launch_ts = settings.coming_soon_launch | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    if launch_ts > now_ts
      assign coming_soon = true
    endif
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if coming_soon %} class="is-coming-soon"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google-site-verification" content="QRrsQ9gNT8f4tbhR9XI0yyxNIwnc2OlmbNxRVgCdNHI">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    {%- liquid
      # shop.name comes HTML-escaped (&amp;) while page_title doesn't, so compare against both.
      assign brand = shop.name | replace: '&amp;', '&'
      assign seo_title = page_title
      assign seo_description = page_description | strip_html | strip
      if request.page_type == 'index'
        if page_title == brand or page_title == shop.name
          assign seo_title = settings.seo_home_title | default: page_title
        endif
        if seo_description == blank or seo_description == brand or seo_description == shop.name
          assign seo_description = settings.seo_home_description
        endif
      elsif request.page_type == 'blog' and blog.handle == settings.main_blog.handle
        assign seo_title = 'Blogs'
      elsif request.page_type == 'collection' and collection
        if collection.handle == 'all' and page_title == 'Products'
          assign seo_title = settings.seo_all_title | default: page_title
        endif
        if seo_description == blank
          assign collection_label = collection.title
          if collection.handle == 'all'
            assign collection_label = 'baby clothes and essentials'
          endif
          assign seo_description = settings.seo_collection_description | replace: '[collection]', collection_label
        endif
      endif
      if seo_description == blank
        assign seo_description = settings.seo_home_description
      endif
    -%}
    <title>
      {{- seo_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless seo_title contains brand or seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | truncate: 300 | escape_once }}">
    {%- endif -%}
    {%- if request.page_type == 'cart' or request.page_type == 'search' or request.page_type contains 'customers/' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}
    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}

    {% render 'font-face' %}

    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-accent: {{ settings.color_accent }};
        --product-ratio: {{ settings.product_image_ratio | default: '1 / 1' }};
        --product-fit: {{ settings.product_image_fit | default: 'contain' }};
        --collection-ratio: {{ settings.collection_image_ratio | default: '3 / 4' }};
        --collection-fit: {{ settings.collection_image_fit | default: 'contain' }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        shopPath: {{ settings.shop_path | json }},
        giftBoxVariantId: {% if settings.gift_box_product.available %}{{ settings.gift_box_product.selected_or_first_available_variant.id }}{% else %}null{% endif %},
        giftBoxPrice: {% if settings.gift_box_product.available %}{{ settings.gift_box_product.selected_or_first_available_variant.price }}{% else %}0{% endif %},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          allProducts: {{ routes.all_products_collection_url | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix != blank %}--{{ template.suffix }}{% endif %}">
    {%- if coming_soon -%}{% render 'coming-soon', launch: settings.coming_soon_launch %}{%- endif -%}
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}

    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
