[
  {
    "name": "theme_info",
    "theme_name": "Cuddles",
    "theme_version": "1.0.0",
    "theme_author": "Cuddles",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Coming soon",
    "settings": [
      {
        "type": "checkbox",
        "id": "coming_soon_enabled",
        "label": "Lock the store behind a countdown",
        "default": true,
        "info": "Visitors only see the countdown until the launch time, then the store opens by itself. The theme editor always shows the store."
      },
      {
        "type": "text",
        "id": "coming_soon_launch",
        "label": "Launch time",
        "default": "2026-10-20T22:50:00+05:30",
        "info": "Format: YYYY-MM-DDTHH:MM:SS+05:30 (IST). Example: 2026-10-20T22:50:00+05:30 is 10:50 PM IST, 20 Oct 2026."
      },
      {
        "type": "image_picker",
        "id": "coming_soon_logo",
        "label": "Logo",
        "info": "Single-color logo, recolored to the text color. Defaults to the header logo artwork."
      },
      {
        "type": "text",
        "id": "coming_soon_eyebrow",
        "label": "Eyebrow",
        "default": "Coming soon"
      },
      {
        "type": "text",
        "id": "coming_soon_heading",
        "label": "Heading",
        "default": "Something soft is on its way."
      },
      {
        "type": "textarea",
        "id": "coming_soon_text",
        "label": "Message",
        "default": "Our first collection drops tonight. Stay close."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFAE9"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#805B4B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#805B4B"
      }
    ]
  },
  {
    "name": "Product images",
    "settings": [
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Image shape",
        "default": "1 / 1",
        "info": "Every product card and product page image uses this shape, so rows stay aligned.",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "Portrait"
          },
          {
            "value": "3 / 4",
            "label": "Tall portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "product_image_fit",
        "label": "Image fit",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Show whole image"
          },
          {
            "value": "cover",
            "label": "Fill shape (may crop)"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_image_ratio",
        "label": "Collection image shape",
        "default": "3 / 4",
        "info": "Used by Shop by collection and the Collections page. Every tile uses the same shape so rows stay aligned.",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "Portrait"
          },
          {
            "value": "3 / 4",
            "label": "Tall portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_image_fit",
        "label": "Collection image fit",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Show whole image"
          },
          {
            "value": "cover",
            "label": "Fill shape (may crop)"
          }
        ]
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Displayed at 32 × 32px"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ]
      },
      {
        "type": "header",
        "content": "Gift box"
      },
      {
        "type": "product",
        "id": "gift_box_product",
        "label": "Gift box product",
        "info": "Create a product called 'Gift box' priced at the gift box fee (e.g. ₹200). Product pages then offer 'Standard' or 'Gift box', and one gift box is added to the bag for each gift-boxed item. Leave empty to hide the option."
      }
    ]
  },
  {
    "name": "Shop page",
    "settings": [
      {
        "type": "text",
        "id": "shop_path",
        "label": "Address shown for all products",
        "default": "/shop",
        "info": "Also create a URL redirect from this path to /collections/all (Online Store > Navigation > URL redirects). Leave empty to show /collections/all."
      }
    ]
  },
  {
    "name": "Search & sharing",
    "settings": [
      {
        "type": "text",
        "id": "seo_home_heading",
        "label": "Homepage heading for search engines",
        "info": "Hidden from shoppers. Used as the homepage H1 when the hero heading is empty. Example: Cuddles – soft cotton baby clothes made in India"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image",
        "info": "Shown when links to pages without their own image are shared (WhatsApp, Instagram, Facebook). 1200 × 630px recommended."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "https://instagram.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      }
    ]
  }
]
