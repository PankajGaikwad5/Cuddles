[
  {
    "name": "theme_info",
    "theme_name": "Cuddles",
    "theme_version": "1.0.0",
    "theme_author": "Cuddles",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFAE9"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#805B4B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#805B4B"
      }
    ]
  },
  {
    "name": "Product images",
    "settings": [
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Image shape",
        "default": "1 / 1",
        "info": "Every product card and product page image uses this shape, so rows stay aligned.",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "Portrait"
          },
          {
            "value": "3 / 4",
            "label": "Tall portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "product_image_fit",
        "label": "Image fit",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Show whole image"
          },
          {
            "value": "cover",
            "label": "Fill shape (may crop)"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_image_ratio",
        "label": "Collection image shape",
        "default": "3 / 4",
        "info": "Used by Shop by collection and the Collections page. Every tile uses the same shape so rows stay aligned.",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "Portrait"
          },
          {
            "value": "3 / 4",
            "label": "Tall portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_image_fit",
        "label": "Collection image fit",
        "default": "contain",
        "options": [
          {
            "value": "contain",
            "label": "Show whole image"
          },
          {
            "value": "cover",
            "label": "Fill shape (may crop)"
          }
        ]
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Displayed at 32 × 32px"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ]
      }
    ]
  },
  {
    "name": "Shop page",
    "settings": [
      {
        "type": "text",
        "id": "shop_path",
        "label": "Address shown for all products",
        "default": "/shop",
        "info": "Also create a URL redirect from this path to /collections/all (Online Store > Navigation > URL redirects). Leave empty to show /collections/all."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "https://instagram.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      }
    ]
  }
]
