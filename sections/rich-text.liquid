<section class="rich-text rich-text--{{ section.settings.align }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="simple-page__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="faq__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="rich-text__body rte">{{ section.settings.text }}</div>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button-outline rich-text__button">{{ section.settings.button_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand with your customers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
