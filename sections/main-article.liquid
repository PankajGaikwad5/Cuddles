{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_minutes = word_count | divided_by: 200.0 | ceil
  if read_minutes < 1
    assign read_minutes = 1
  endif
-%}
{%- capture blogs_href -%}{% render 'link-href', url: '/blogs' %}{%- endcapture -%}
{%- if blogs_href == '/blogs' -%}{%- assign blogs_href = blog.url -%}{%- endif -%}

<article class="article">
  <header class="article__head">
    <p class="article__crumb"><a href="{{ blogs_href }}">{{ section.settings.crumb_label | default: 'Blogs' }}</a></p>
    <h1 class="article__title">{{ article.title }}</h1>
    <p class="article__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time>
      {%- if section.settings.show_author %}<span aria-hidden="true">·</span>{{ article.author }}{% endif -%}
      <span aria-hidden="true">·</span>{{ read_minutes }} min read
    </p>
  </header>

  {%- if article.image -%}
    {%- assign focal = article.image.presentation.focal_point | default: 'center' | prepend: 'object-position: ' -%}
    {%- assign image_alt = article.image.alt | default: article.title -%}
    <figure class="article__image">
      {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: image_alt, sizes: '(min-width: 1100px) 1040px, 100vw', style: focal }}
    </figure>
  {%- endif -%}

  <div class="rte article__content">{{ article.content }}</div>

  <footer class="article__foot">
    {%- if article.tags.size > 0 -%}
      <ul class="article__tags">
        {%- for tag in article.tags -%}<li>{{ tag }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="article__actions">
      <a href="{{ blogs_href }}" class="button-outline">Back to {{ section.settings.crumb_label | default: 'Blogs' }}</a>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button-solid">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </footer>

  {%- if blog.comments_enabled? -%}
    <div class="article__comments">
      {%- if article.comments_count > 0 -%}
        <h2 class="related__heading">{{ article.comments_count }} {% if article.comments_count == 1 %}comment{% else %}comments{% endif %}</h2>
        {%- paginate article.comments by 10 -%}
          <ul class="comment-list">
            {%- for comment in article.comments -%}
              <li class="comment">
                <div class="rte">{{ comment.content }}</div>
                <p class="article__meta">{{ comment.author }} · {{ comment.created_at | date: '%d %B %Y' }}</p>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}

      {%- form 'new_comment', article, class: 'form' -%}
        <h2 class="related__heading">Leave a comment</h2>
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">
            {%- if blog.moderated? -%}Thanks — your comment will appear once approved.{%- else -%}Thanks for your comment.{%- endif -%}
          </p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form__row">
          <label class="field"><span class="field__label">Name</span><input type="text" name="comment[author]" value="{{ form.author }}" required></label>
          <label class="field"><span class="field__label">Email</span><input type="email" name="comment[email]" value="{{ form.email }}" required></label>
        </div>
        <label class="field"><span class="field__label">Comment</span><textarea name="comment[body]" rows="5" required>{{ form.body }}</textarea></label>
        <button type="submit" class="button-solid form__submit">Post comment</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "text", "id": "crumb_label", "label": "Link back label", "default": "Blogs" },
    { "type": "text", "id": "cta_label", "label": "Shop button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Shop button link" }
  ]
}
{% endschema %}
