<section class="hero about-hero" style="--hero-overlay: 0.15; --hero-text: #fffae9;">
  {%- liquid
    # URL field accepts a full URL or the file name of a theme asset (e.g. middlevid.mp4).
    assign video_src = section.settings.video_url
    if video_src != blank
      unless video_src contains '/'
        assign video_src = video_src | asset_url
      endunless
    endif
  -%}
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'hero__video', image_size: '1600x' }}
    {%- elsif video_src != blank -%}
      <video class="hero__video" src="{{ video_src }}" autoplay muted loop playsinline preload="metadata"></video>
    {%- endif -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero__content">
    <button type="button" class="hero__scroll" aria-label="Scroll down" data-scroll-down>
      {% render 'icon', name: 'chevron-down' %}
    </button>
  </div>
</section>

{% schema %}
{
  "name": "About video",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (upload)" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4) fallback", "info": "Used when no video is uploaded. Full URL, or a file name from the theme assets folder." }
  ],
  "presets": [{ "name": "About video" }]
}
{% endschema %}
