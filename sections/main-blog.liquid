{%- liquid
  comment
    Normally we list the articles of the blog being viewed. When "Show posts from
    every blog" is on, we list every blog's articles on one page, with the blogs
    ordered by their newest post. Tag filtering always stays scoped to one blog.

    Note: we never build an array of articles with `concat`. blog.articles is a lazy
    drop, not a true array, so concat silently produces an empty list. We only ever
    loop it directly, and order blogs via a plain array of strings, which is safe.
  endcomment

  assign aggregated = false
  assign total_posts = blog.articles_count

  if section.settings.all_blogs and current_tags == blank
    assign total_posts = 0
    assign keys_raw = ''
    for other_blog in blogs
      if other_blog.articles_count > 0
        assign total_posts = total_posts | plus: other_blog.articles_count
        assign newest = ''
        for newest_article in other_blog.articles limit: 1
          assign newest = newest_article.published_at | date: '%s'
        endfor
        assign keys_raw = keys_raw | append: newest | append: '|' | append: other_blog.handle | append: '~~'
      endif
    endfor
    assign blog_keys = keys_raw | split: '~~' | sort | reverse

    comment
      Only switch to the combined list if we actually found posts this way; otherwise
      fall back to the normal single-blog listing so the page is never empty.
    endcomment
    if total_posts > 0
      assign aggregated = true
    else
      assign total_posts = blog.articles_count
    endif
  endif
-%}

<section class="collection">
  <header class="collection__hero">
    <h1 class="collection__title">{{ section.settings.heading | default: blog.title }}</h1>
    {%- if blog.all_tags.size > 0 and aggregated == false -%}
      <ul class="blog-tags">
        <li><a href="{{ blog.url }}" {% unless current_tags %}class="is-active"{% endunless %}>All</a></li>
        {%- for tag in blog.all_tags -%}
          <li>
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}class="is-active"{% endif %}>{{ tag }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </header>

  {%- if total_posts == 0 -%}
    <div class="blog-empty">
      <p class="simple-page__eyebrow">{{ section.settings.empty_eyebrow }}</p>
      <h2 class="faq__heading">{{ section.settings.empty_heading }}</h2>
      <div class="rich-text__body rte">{{ section.settings.empty_text }}</div>
      <a href="{{ routes.all_products_collection_url }}" class="button-outline rich-text__button">Shop the collection</a>
    </div>
  {%- endif -%}

  {%- comment -%}
    Build the combined grid into a buffer first. If it somehow came out empty (a blog
    handle that won't resolve, say), drop back to the normal single-blog listing
    rather than showing the visitor a blank page.
  {%- endcomment -%}
  {%- if aggregated -%}
    {%- capture grid_html -%}
      {%- for blog_key in blog_keys -%}
        {%- assign blog_handle = blog_key | split: '|' | last -%}
        {%- for article in blogs[blog_handle].articles -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if grid_html contains 'article-card' -%}
      <div class="article-grid">{{ grid_html }}</div>
    {%- else -%}
      {%- assign aggregated = false -%}
    {%- endif -%}
  {%- endif -%}

  {%- unless aggregated -%}
    {%- paginate blog.articles by section.settings.per_page -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to show the blog's own name.", "default": "Blogs" },
    { "type": "checkbox", "id": "all_blogs", "label": "Show posts from every blog", "info": "On: this page lists posts from all blogs on the store, newest first. Off: only posts from the blog being viewed.", "default": true },
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 3, "max": 24, "step": 3, "default": 9, "info": "Only applies when \"Show posts from every blog\" is off." },
    { "type": "header", "content": "When there are no posts yet" },
    { "type": "text", "id": "empty_eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Stories from our world" },
    { "type": "richtext", "id": "empty_text", "label": "Text", "default": "<p>Behind-the-scenes moments, styling notes and little stories from Mia &amp; Co. are on their way.</p>" }
  ]
}
{% endschema %}
