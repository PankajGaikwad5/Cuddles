<section class="collection">
  <header class="collection__hero">
    <h1 class="collection__title">{{ section.settings.heading }}</h1>
  </header>

  <div class="collection-list">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <a href="{{ collection.url }}" class="collection-tile">
          <div class="collection-tile__media">
            {%- assign tile_image = collection.featured_image | default: collection.products.first.featured_image -%}
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: collection.title, sizes: '(min-width: 990px) 33vw, 50vw' }}
            {%- endif -%}
          </div>
          <h2 class="collection-tile__title">{{ collection.title }}</h2>
          <p class="collection-tile__count">{{ collection.products_count }} pieces</p>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
