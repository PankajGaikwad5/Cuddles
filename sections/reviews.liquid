{%- liquid
  assign total = 0
  assign counted = 0
  for block in section.blocks
    assign rating = block.settings.rating
    if rating > 0
      assign total = total | plus: rating
      assign counted = counted | plus: 1
    endif
  endfor
  if counted > 0
    assign average = total | times: 1.0 | divided_by: counted | round: 1
  endif
-%}

<section class="reviews" data-slider>
  <header class="picks__head reviews__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="simple-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="showcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_summary and counted > 0 -%}
        <p class="reviews__summary">
          <span class="review-card__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= average -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
            {%- endfor -%}
          </span>
          <span>{{ average }}/5 &middot; {{ counted }} reviews</span>
        </p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="picks__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="picks__nav">
      <button type="button" class="picks__arrow" data-slider-step="-1" aria-label="Previous reviews">{% render 'icon', name: 'arrow-left' %}</button>
      <button type="button" class="picks__arrow" data-slider-step="1" aria-label="Next reviews">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  </header>

  <div class="reviews__track" data-slider-track style="--reviews-cols: {{ section.settings.columns }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign rating = block.settings.rating
        assign name = block.settings.name | default: 'Anonymous'
      -%}
      <article class="reviews__item" {{ block.shopify_attributes }}>
        <div class="review-card">
          {%- if rating > 0 -%}
            <p class="review-card__stars">
              <span class="visually-hidden">{{ rating }} out of 5 stars</span>
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}
          <blockquote class="review-card__text">{{ block.settings.text | escape | newline_to_br }}</blockquote>
          <footer class="review-card__foot">
            <p class="review-card__name">{{ name }}</p>
            {%- if block.settings.meta != blank -%}
              <p class="review-card__meta">{{ block.settings.meta }}</p>
            {%- endif -%}
          </footer>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents are saying" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_summary", "label": "Show average rating", "default": true },
    { "type": "range", "id": "columns", "label": "Cards per view on desktop", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Anonymous" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "meta", "label": "Label", "info": "Optional, e.g. the product or city." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
