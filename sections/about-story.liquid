<section class="about-story about-story--image-{{ section.settings.image_position }}{% if section.settings.image == blank and section.settings.image_url == blank %} about-story--text-only{% endif %}">
  {%- liquid
    # URL field accepts a full URL or the file name of a theme asset (e.g. leftimg.png).
    assign image = section.settings.image
    assign image_src = section.settings.image_url
    if image_src != blank
      unless image_src contains '/'
        assign image_src = image_src | asset_url
      endunless
    endif
  -%}

  {%- if image != blank or image_src != blank -%}
    <div class="about-story__media">
      {%- if image != blank -%}
        {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.heading }}
      {%- else -%}
        <img src="{{ image_src }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="about-story__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="simple-page__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="about-story__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <div class="about-story__body rte">{{ section.settings.text }}</div>
    {%- if section.settings.closing != blank -%}
      <p class="about-story__closing">{{ section.settings.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL or theme asset", "info": "Used when no image is picked. Full URL, or a file name from the theme assets folder (e.g. leftimg.png)." },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Cuddles" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cuddles by Mia & Co." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "text", "id": "closing", "label": "Closing line" }
  ],
  "presets": [{ "name": "About story" }]
}
{% endschema %}
