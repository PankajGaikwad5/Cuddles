<section class="simple-page">
  <header class="page-head">
    <h1 class="page-head__title">{{ section.settings.heading | default: page.title }}</h1>
  </header>

  {%- if page.content != blank -%}
    <div class="rte simple-page__content">{{ page.content }}</div>
  {%- endif -%}

  {%- form 'contact', id: 'ContactForm', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">Thank you — we'll be in touch soon.</p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="form__row">
      <label class="field">
        <span class="field__label">Name</span>
        <input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
      </label>
      <label class="field">
        <span class="field__label">Email *</span>
        <input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      </label>
    </div>
    <label class="field">
      <span class="field__label">Phone</span>
      <input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    </label>
    <label class="field">
      <span class="field__label">Message</span>
      <textarea name="contact[body]" rows="6">{{ form.body }}</textarea>
    </label>
    <button type="submit" class="button-solid form__submit">Send</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
