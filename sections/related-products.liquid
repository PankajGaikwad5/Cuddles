{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = product.collections.first
  endif
  assign shown = 0
-%}

{%- if source != blank and source.products.size > 1 -%}
  <section class="related">
    <h2 class="related__heading">{{ section.settings.heading }}</h2>
    <div class="product-grid" style="--grid-cols: 4;">
      {%- for item in source.products -%}
        {%- if item.id != product.id and shown < section.settings.limit -%}
          {% render 'product-card', product: item, loading: 'lazy' %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to the product's first collection." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
