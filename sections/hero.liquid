{%- liquid
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

<section class="hero" style="--hero-overlay: {{ overlay }}; --hero-text: {{ section.settings.text_color }};">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero__video', image_size: '1600x' }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        class="hero__video"
        src="{{ section.settings.video_url }}"
        {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% elsif section.settings.poster_url != blank %}poster="{{ section.settings.poster_url }}"{% endif %}
        autoplay muted loop playsinline preload="metadata"
      ></video>
    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster | image_url: width: 2000 | image_tag: class: 'hero__video', loading: 'eager' }}
    {%- endif -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">
        {%- assign letters = section.settings.heading | split: '' -%}
        {%- if section.settings.stack_heading -%}
          {%- for letter in letters -%}<span>{{ letter }}</span>{%- endfor -%}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button-glow">
        <span class="button-glow__inner">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right' %}
        </span>
      </a>
    {%- endif -%}

    {%- if section.settings.show_scroll -%}
      <button type="button" class="hero__scroll" aria-label="Scroll down" data-scroll-down>
        {% render 'icon', name: 'chevron-down' %}
      </button>
    {%- endif -%}
  </div>

  {%- if section.settings.left_label != blank -%}
    <a href="{{ section.settings.left_link }}" class="hero__side hero__side--left">
      {% render 'icon', name: 'arrow-left' %} {{ section.settings.left_label }}
    </a>
  {%- endif -%}
  {%- if section.settings.right_label != blank -%}
    <a href="{{ section.settings.right_link }}" class="hero__side hero__side--right">
      {{ section.settings.right_label }} {% render 'icon', name: 'arrow-right' %}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Video (upload)" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4) fallback", "default": "https://res.cloudinary.com/dfpxvbkwt/video/upload/v1792227536/cuddles_websire_zfbsud.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "poster_url", "label": "Poster URL fallback", "default": "https://res.cloudinary.com/dfpxvbkwt/video/upload/so_0/v1792227536/cuddles_websire_zfbsud.jpg" },
    { "type": "range", "id": "overlay", "label": "Overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "stack_heading", "label": "Stack heading letters vertically", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_scroll", "label": "Show scroll-down arrow", "default": true },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFAE9" },
    { "type": "header", "content": "Side links" },
    { "type": "text", "id": "left_label", "label": "Left label" },
    { "type": "url", "id": "left_link", "label": "Left link" },
    { "type": "text", "id": "right_label", "label": "Right label" },
    { "type": "url", "id": "right_link", "label": "Right link" }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
